<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Top: fade the banner into the page background. -->
    <item android:bottom="96dp">
        <shape>
            <gradient
                android:angle="270"
                android:startColor="?android:colorBackground"
                android:endColor="@android:color/transparent"
                android:type="linear" />
        </shape>
    </item>

    <!-- Bottom: reach the page background earlier so the banner does not end as a hard image block. -->
    <item android:top="160dp">
        <shape>
            <gradient
                android:angle="270"
                android:startColor="@android:color/transparent"
                android:centerColor="?android:colorBackground"
                android:endColor="?android:colorBackground"
                android:centerY="0.55"
                android:type="linear" />
        </shape>
    </item>

</layer-list>
