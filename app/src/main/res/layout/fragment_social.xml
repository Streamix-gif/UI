<?xml version="1.0" encoding="utf-8"?>
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/socialRefresh"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/socialAppTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="AniLab"
                        android:textSize="26sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/socialAppSubtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Anime Brings Us Together"
                        android:textSize="12sp"
                        android:alpha=".62" />
                </LinearLayout>

                <ImageButton
                    android:id="@+id/socialSearchButton"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:background="@android:color/transparent"
                    android:contentDescription="@string/search"
                    android:src="@drawable/ic_round_search_24"
                    app:tint="#E8E9F2" />

                <ImageButton
                    android:id="@+id/socialNotificationButton"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:background="@android:color/transparent"
                    android:contentDescription="@string/notifications"
                    android:src="@drawable/ic_round_notifications_active_24"
                    app:tint="#E8E9F2" />

                <TextView
                    android:id="@+id/socialAvatar"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="2dp"
                    android:gravity="center"
                    android:text="U"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:background="@drawable/social_avatar_bg" />
            </LinearLayout>

            <TextView
                android:id="@+id/socialHeaderTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Social"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/socialHeaderSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="Find friends. Chat. Watch together."
                android:textSize="14sp"
                android:alpha=".62" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="0dp"
                android:scrollbars="none">

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/socialFilters"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    app:chipSpacingHorizontal="6dp"
                    app:singleLine="true"
                    app:singleSelection="true" />
            </HorizontalScrollView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/watchTogetherCard"
                android:layout_width="match_parent"
                android:layout_height="142dp"
                android:layout_marginTop="8dp"
                app:cardBackgroundColor="@android:color/transparent"
                app:cardCornerRadius="20dp"
                app:strokeColor="#3D4670"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/social_hero_bg"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="18dp"
                    android:paddingTop="16dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="16dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="WATCH TOGETHER"
                            android:textColor="#91A6FF"
                            android:textSize="10sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="Watch Together"
                            android:textSize="20sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:text="Create a room, invite friends, and enjoy anime together."
                            android:textSize="12sp"
                            android:alpha=".72" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="50dp"
                        android:layout_height="50dp"
                        android:layout_marginStart="10dp"
                        android:gravity="center"
                        android:text="›"
                        android:textSize="34sp"
                        android:textStyle="normal"
                        android:background="@drawable/social_circle_bg" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Existing 3-card carousel: auto-rotates in SocialFragment every 4 seconds. -->
            <LinearLayout
                android:id="@+id/socialFeatureCarousel"
                android:layout_width="match_parent"
                android:layout_height="88dp"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/socialGlobalChatCard"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardCornerRadius="16dp"
                    app:strokeColor="#403F61"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="7dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="●  Global Chat"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="Chat with everyone"
                            android:textSize="10sp"
                            android:alpha=".62" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/socialAnimeChatCard"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardCornerRadius="16dp"
                    app:strokeColor="#403F61"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="7dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="●  Anime Chat"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="Discuss anime"
                            android:textSize="10sp"
                            android:alpha=".62" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/socialLeaderboardCard"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardCornerRadius="16dp"
                    app:strokeColor="#403F61"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="7dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="★  Leaderboard"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="Top fans &amp; ranks"
                            android:textSize="10sp"
                            android:alpha=".62" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Community Leaderboard"
                    android:textSize="19sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/socialLeaderboardSeeAll"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="See all  ›"
                    android:textSize="12sp"
                    android:alpha=".7" />
            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/socialLeaderboardPanel"
                android:layout_width="match_parent"
                android:layout_height="230dp"
                android:layout_marginTop="8dp"
                app:cardBackgroundColor="#12182A"
                app:cardCornerRadius="18dp"
                app:strokeColor="#2D3350"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:gravity="bottom|center_horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="145dp"
                            android:layout_weight="1"
                            android:gravity="center_horizontal"
                            android:orientation="vertical"
                            android:padding="5dp">

                            <TextView
                                android:layout_width="44dp"
                                android:layout_height="44dp"
                                android:gravity="center"
                                android:text="K"
                                android:textColor="#FFFFFF"
                                android:textSize="17sp"
                                android:textStyle="bold"
                                android:background="@drawable/social_avatar_bg" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="5dp"
                                android:text="Kael"
                                android:textSize="12sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="12,450 pts"
                                android:textSize="10sp"
                                android:alpha=".7" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="48dp"
                                android:layout_marginTop="5dp"
                                android:gravity="center"
                                android:text="②"
                                android:textSize="26sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="170dp"
                            android:layout_weight="1"
                            android:gravity="center_horizontal"
                            android:orientation="vertical"
                            android:padding="5dp">

                            <TextView
                                android:layout_width="50dp"
                                android:layout_height="50dp"
                                android:gravity="center"
                                android:text="R"
                                android:textColor="#FFFFFF"
                                android:textSize="19sp"
                                android:textStyle="bold"
                                android:background="@drawable/social_gold_avatar_bg" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="5dp"
                                android:text="Rynn"
                                android:textSize="13sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="15,230 pts"
                                android:textSize="10sp" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="58dp"
                                android:layout_marginTop="5dp"
                                android:gravity="center"
                                android:text="①"
                                android:textSize="34sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="145dp"
                            android:layout_weight="1"
                            android:gravity="center_horizontal"
                            android:orientation="vertical"
                            android:padding="5dp">

                            <TextView
                                android:layout_width="44dp"
                                android:layout_height="44dp"
                                android:gravity="center"
                                android:text="H"
                                android:textColor="#FFFFFF"
                                android:textSize="17sp"
                                android:textStyle="bold"
                                android:background="@drawable/social_avatar_bg" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="5dp"
                                android:text="Hana"
                                android:textSize="12sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="10,980 pts"
                                android:textSize="10sp"
                                android:alpha=".7" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="48dp"
                                android:layout_marginTop="5dp"
                                android:gravity="center"
                                android:text="③"
                                android:textSize="26sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:gravity="center_vertical"
                            android:text="#4  Mizu     8,420 pts"
                            android:textSize="11sp" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:gravity="center_vertical"
                            android:text="#5  Shin      7,890 pts"
                            android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Friend Activity"
                android:textSize="19sp"
                android:textStyle="bold" />

            <FrameLayout
                android:id="@+id/socialFeedContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp" />

            <TextView
                android:id="@+id/socialEmpty"
                android:layout_width="match_parent"
                android:layout_height="96dp"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:text="No friend activity yet"
                android:textSize="12sp"
                android:alpha=".55"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Active Friends"
                    android:textSize="19sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="●  6 online  ›"
                    android:textColor="#7ED6A5"
                    android:textSize="12sp"
                    android:alpha=".85" />
            </LinearLayout>

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="112dp"
                android:layout_marginTop="8dp"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:orientation="horizontal">

                    <LinearLayout style="@style/SocialFriendItem">
                        <FrameLayout style="@style/SocialFriendAvatar">
                            <TextView style="@style/SocialFriendInitial" android:text="S" />
                            <View style="@style/SocialOnlineDot" />
                        </FrameLayout>
                        <TextView style="@style/SocialFriendName" android:text="Shin" />
                        <TextView style="@style/SocialFriendStatus" android:text="Watching" />
                    </LinearLayout>

                    <LinearLayout style="@style/SocialFriendItem">
                        <FrameLayout style="@style/SocialFriendAvatar">
                            <TextView style="@style/SocialFriendInitial" android:text="K" />
                            <View style="@style/SocialOnlineDot" />
                        </FrameLayout>
                        <TextView style="@style/SocialFriendName" android:text="Kael" />
                        <TextView style="@style/SocialFriendStatus" android:text="Online" />
                    </LinearLayout>

                    <LinearLayout style="@style/SocialFriendItem">
                        <FrameLayout style="@style/SocialFriendAvatar">
                            <TextView style="@style/SocialFriendInitial" android:text="R" />
                            <View style="@style/SocialOnlineDot" />
                        </FrameLayout>
                        <TextView style="@style/SocialFriendName" android:text="Rynn" />
                        <TextView style="@style/SocialFriendStatus" android:text="In Room" />
                    </LinearLayout>

                    <LinearLayout style="@style/SocialFriendItem">
                        <FrameLayout style="@style/SocialFriendAvatar">
                            <TextView style="@style/SocialFriendInitial" android:text="M" />
                            <View style="@style/SocialOnlineDot" />
                        </FrameLayout>
                        <TextView style="@style/SocialFriendName" android:text="Mizu" />
                        <TextView style="@style/SocialFriendStatus" android:text="Online" />
                    </LinearLayout>

                    <LinearLayout style="@style/SocialFriendItem">
                        <FrameLayout style="@style/SocialFriendAvatar">
                            <TextView style="@style/SocialFriendInitial" android:text="S" />
                        </FrameLayout>
                        <TextView style="@style/SocialFriendName" android:text="Sora" />
                        <TextView style="@style/SocialFriendStatus" android:text="Offline" />
                    </LinearLayout>

                    <LinearLayout style="@style/SocialFriendItem">
                        <FrameLayout style="@style/SocialFriendAvatar">
                            <TextView style="@style/SocialFriendInitial" android:text="Y" />
                            <View style="@style/SocialOnlineDot" />
                        </FrameLayout>
                        <TextView style="@style/SocialFriendName" android:text="Yuki" />
                        <TextView style="@style/SocialFriendStatus" android:text="Online" />
                    </LinearLayout>
                </LinearLayout>
            </HorizontalScrollView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Recent Messages"
                    android:textSize="19sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="See all  ›"
                    android:textSize="12sp"
                    android:alpha=".7" />
            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                app:cardBackgroundColor="#12182A"
                app:cardCornerRadius="16dp"
                app:strokeColor="#2D3350"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout style="@style/SocialMessageRow">
                        <TextView style="@style/SocialMessageAvatar" android:text="K" />
                        <LinearLayout style="@style/SocialMessageText">
                            <TextView style="@style/SocialMessageName" android:text="Kael" />
                            <TextView style="@style/SocialMessageBody" android:text="Bro, episode terbaru udah rilis?" />
                        </LinearLayout>
                        <TextView style="@style/SocialMessageCount" android:text="3" />
                    </LinearLayout>

                    <LinearLayout style="@style/SocialMessageRow">
                        <TextView style="@style/SocialMessageAvatar" android:text="H" />
                        <LinearLayout style="@style/SocialMessageText">
                            <TextView style="@style/SocialMessageName" android:text="Hana" />
                            <TextView style="@style/SocialMessageBody" android:text="Yuk nonton bareng nanti malam!" />
                        </LinearLayout>
                        <TextView style="@style/SocialMessageCount" android:text="1" />
                    </LinearLayout>

                    <LinearLayout style="@style/SocialMessageRow">
                        <TextView style="@style/SocialMessageAvatar" android:text="R" />
                        <LinearLayout style="@style/SocialMessageText">
                            <TextView style="@style/SocialMessageName" android:text="Rynn" />
                            <TextView style="@style/SocialMessageBody" android:text="Gila sih, episode kemarin keren." />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>