<?xml version="1.0" encoding="utf-8"?>
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/socialRefresh"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="18dp"
            android:paddingEnd="16dp"
            android:paddingBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/socialAppTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Streamix"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/socialAppSubtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Anime brings us together"
                        android:textSize="11sp"
                        android:alpha=".65" />
                </LinearLayout>

                <ImageButton
                    android:id="@+id/socialSearchButton"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@android:color/transparent"
                    android:contentDescription="@string/search"
                    android:src="@drawable/ic_round_search_24"
                    app:tint="@color/bg_opp" />

                <ImageButton
                    android:id="@+id/socialNotificationButton"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@android:color/transparent"
                    android:contentDescription="@string/notifications"
                    android:src="@drawable/ic_round_notifications_active_24"
                    app:tint="@color/bg_opp" />

                <TextView
                    android:id="@+id/socialAvatar"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="4dp"
                    android:gravity="center"
                    android:text="U"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@android:color/white"
                    android:background="@drawable/social_avatar_bg" />
            </LinearLayout>

            <TextView
                android:id="@+id/socialHeaderTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Social"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/socialHeaderSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="Find friends. Chat. Watch together."
                android:textSize="14sp"
                android:alpha=".65" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/watchTogetherCard"
                android:layout_width="match_parent"
                android:layout_height="142dp"
                android:layout_marginTop="14dp"
                app:cardBackgroundColor="@android:color/transparent"
                app:cardCornerRadius="20dp"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/social_hero_bg"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="18dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Watch Together"
                            android:textSize="19sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:text="Create a room, invite friends, and enjoy anime together."
                            android:textSize="12sp"
                            android:alpha=".72" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="50dp"
                        android:layout_height="50dp"
                        android:gravity="center"
                        android:text="›"
                        android:textSize="34sp"
                        android:background="@drawable/social_circle_bg" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="88dp"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/socialGlobalChatCard"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardCornerRadius="16dp"
                    app:strokeWidth="1dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical" android:padding="7dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="●  Global Chat" android:textStyle="bold" android:textSize="13sp"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="Chat with everyone" android:textSize="10sp" android:alpha=".65"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/socialAnimeChatCard"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardCornerRadius="16dp"
                    app:strokeWidth="1dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical" android:padding="7dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="●  Anime Chat" android:textStyle="bold" android:textSize="13sp"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="Discuss anime" android:textSize="10sp" android:alpha=".65"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/socialLeaderboardCard"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardCornerRadius="16dp"
                    app:strokeWidth="1dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical" android:padding="7dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="★  Leaderboard" android:textStyle="bold" android:textSize="13sp"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="Top fans &amp; ranks" android:textSize="10sp" android:alpha=".65"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:gravity="center_vertical">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Community Leaderboard"
                    android:textSize="19sp"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/socialLeaderboardSeeAll"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="See all  ›"
                    android:textSize="12sp"
                    android:alpha=".7" />
            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/socialLeaderboardPanel"
                android:layout_width="match_parent"
                android:layout_height="230dp"
                android:layout_marginTop="8dp"
                app:cardCornerRadius="18dp"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:gravity="bottom|center_horizontal">

                        <LinearLayout android:layout_width="0dp" android:layout_height="145dp" android:layout_weight="1" android:gravity="center_horizontal" android:orientation="vertical" android:padding="6dp">
                            <TextView android:layout_width="44dp" android:layout_height="44dp" android:gravity="center" android:text="2" android:textSize="18sp" android:textStyle="bold" android:background="@drawable/social_avatar_bg"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="Kael" android:textStyle="bold" android:textSize="12sp"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="12,450 pts" android:textSize="10sp" android:alpha=".7"/>
                            <TextView android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="6dp" android:gravity="center" android:text="②" android:textSize="26sp"/>
                        </LinearLayout>

                        <LinearLayout android:layout_width="0dp" android:layout_height="170dp" android:layout_weight="1" android:gravity="center_horizontal" android:orientation="vertical" android:padding="6dp">
                            <TextView android:layout_width="50dp" android:layout_height="50dp" android:gravity="center" android:text="1" android:textSize="20sp" android:textStyle="bold" android:background="@drawable/social_gold_avatar_bg"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="Rynn" android:textStyle="bold" android:textSize="13sp"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="15,230 pts" android:textSize="10sp"/>
                            <TextView android:layout_width="match_parent" android:layout_height="58dp" android:layout_marginTop="5dp" android:gravity="center" android:text="①" android:textSize="34sp"/>
                        </LinearLayout>

                        <LinearLayout android:layout_width="0dp" android:layout_height="145dp" android:layout_weight="1" android:gravity="center_horizontal" android:orientation="vertical" android:padding="6dp">
                            <TextView android:layout_width="44dp" android:layout_height="44dp" android:gravity="center" android:text="3" android:textSize="18sp" android:textStyle="bold" android:background="@drawable/social_avatar_bg"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="Hana" android:textStyle="bold" android:textSize="12sp"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="10,980 pts" android:textSize="10sp" android:alpha=".7"/>
                            <TextView android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="6dp" android:gravity="center" android:text="③" android:textSize="26sp"/>
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout android:layout_width="match_parent" android:layout_height="52dp" android:gravity="center_vertical" android:orientation="horizontal">
                        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center_vertical" android:text="#4  Mizu     8,420 pts" android:textSize="11sp"/>
                        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center_vertical" android:text="#5  Shin      7,890 pts" android:textSize="11sp"/>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Friend Activity"
                android:textSize="19sp"
                android:textStyle="bold" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/socialRecycler"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:nestedScrollingEnabled="false"
                android:clipToPadding="false"
                android:paddingBottom="2dp" />

            <TextView
                android:id="@+id/socialEmpty"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:gravity="center"
                android:text="@string/empty"
                android:alpha=".6"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center_vertical">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Active Friends" android:textSize="19sp" android:textStyle="bold"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="●  6 online  ›" android:textSize="12sp" android:alpha=".75"/>
            </LinearLayout>

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="106dp"
                android:layout_marginTop="8dp"
                android:scrollbars="none">
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:orientation="horizontal">

                    <TextView android:layout_width="72dp" android:layout_height="match_parent" android:gravity="center_horizontal" android:text="Shin&#10;● Watching" android:textSize="11sp" android:paddingTop="4dp"/>
                    <TextView android:layout_width="72dp" android:layout_height="match_parent" android:gravity="center_horizontal" android:text="Kael&#10;● Online" android:textSize="11sp" android:paddingTop="4dp"/>
                    <TextView android:layout_width="72dp" android:layout_height="match_parent" android:gravity="center_horizontal" android:text="Rynn&#10;● In Room" android:textSize="11sp" android:paddingTop="4dp"/>
                    <TextView android:layout_width="72dp" android:layout_height="match_parent" android:gravity="center_horizontal" android:text="Mizu&#10;● Online" android:textSize="11sp" android:paddingTop="4dp"/>
                    <TextView android:layout_width="72dp" android:layout_height="match_parent" android:gravity="center_horizontal" android:text="Sora&#10;● Offline" android:textSize="11sp" android:paddingTop="4dp"/>
                    <TextView android:layout_width="72dp" android:layout_height="match_parent" android:gravity="center_horizontal" android:text="Yuki&#10;● Online" android:textSize="11sp" android:paddingTop="4dp"/>
                </LinearLayout>
            </HorizontalScrollView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Recent Messages" android:textSize="19sp" android:textStyle="bold"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="See all  ›" android:textSize="12sp" android:alpha=".7"/>
            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                app:cardCornerRadius="16dp"
                app:strokeWidth="1dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                    <TextView android:layout_width="match_parent" android:layout_height="54dp" android:gravity="center_vertical" android:paddingStart="14dp" android:text="Kael     Bro, episode terbaru udah rilis?                         3" android:textSize="11sp"/>
                    <TextView android:layout_width="match_parent" android:layout_height="54dp" android:gravity="center_vertical" android:paddingStart="14dp" android:text="Hana    Yuk nonton bareng nanti malam!                          1" android:textSize="11sp"/>
                    <TextView android:layout_width="match_parent" android:layout_height="54dp" android:gravity="center_vertical" android:paddingStart="14dp" android:text="Rynn    Gila sih, episode kemarin keren." android:textSize="11sp"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
