<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <FrameLayout
        android:id="@+id/player_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@android:color/black"
        app:layout_constraintDimensionRatio="16:9"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ani.saikou.media.anime.SaikouPrePlaybackView
            android:id="@+id/prePlaybackView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <androidx.media3.ui.PlayerView
            android:id="@+id/player_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            app:animation_enabled="false"
            app:resize_mode="fit"
            app:show_buffering="when_playing" />

        <include
            android:id="@+id/castScreenView"
            layout="@layout/layout_cast_screen"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />
    </FrameLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/player_info_scroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:overScrollMode="never"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/player_container">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="12dp"
            android:paddingEnd="16dp"
            android:paddingBottom="24dp">

            <TextView
                android:id="@+id/player_anime_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_semi_bold"
                android:maxLines="2"
                android:textColor="@color/bg_white"
                android:textSize="17sp" />

            <TextView
                android:id="@+id/player_episode_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:alpha="0.72"
                android:fontFamily="@font/poppins"
                android:maxLines="2"
                android:textColor="@color/bg_white"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/player_resolution_button"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/round_corner"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:minWidth="92dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="1080p ▾"
                android:textColor="@color/bg_white"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/player_resolution_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:alpha="0.55"
                android:text="Pilih resolusi atau server dari tombol di atas"
                android:textColor="@color/bg_white"
                android:textSize="11sp" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
